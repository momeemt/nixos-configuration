{
  system.defaults = {
    ".GlobalPreferences" = {
      # Sets the mouse tracking speed.
      "com.apple.mouse.scaling" = 3.0;
    };

    ActivityMonitor = {
      # CPU usage graph in Dock icon.
      IconType = 5;
      OpenMainWindow = true;
      # All processes.
      ShowCategory = 100;
      SortColumn = "CPUUsage";
      # Ascending
      SortDirection = 0;
    };
  };
}
