{
  system.defaults.NSGlobalDomain = {
    ## Gesture and scroll
    AppleEnableMouseSwipeNavigateWithScrolls = false;
    AppleEnableSwipeNavigateWithScrolls = false;
    NSScrollAnimationEnabled = true;
    "com.apple.swipescrolldirection" = true;

    ## User Interface
    AppleFontSmoothing = null;
    AppleICUForce24HourTime = true;
    AppleIconAppearanceTheme = null;
    AppleInterfaceStyle = "Dark";
    AppleInterfaceStyleSwitchesAutomatically = false;

    ## Keyboard
    AppleKeyboardUIMode = 2;
    ApplePressAndHoldEnabled = false;
    InitialKeyRepeat = 0;
    KeyRepeat = 0;
    "com.apple.keyboard.fnState" = true;

    ## Units
    AppleMeasurementUnits = "Centimeters";
    AppleMetricUnits = 1;
    AppleTemperatureUnit = "Celsius";

    ## Finder
    AppleShowAllExtensions = true;
    AppleShowAllFiles = true;
    NSTableViewDefaultSizeMode = 1;

    ## Window behaviors
    AppleShowScrollBars = "Always";
    AppleSpacesSwitchOnActivate = false;
    AppleWindowTabbingMode = "manual";
    NSAutomaticWindowAnimationsEnabled = false;
    NSDisableAutomaticTermination = false;
    NSNavPanelExpandedStateForSaveMode = true;
    NSNavPanelExpandedStateForSaveMode2 = true;
    PMPrintingExpandedStateForPrint = true;
    PMPrintingExpandedStateForPrint2 = true;
    _HIHideMenuBar = false;
    NSStatusItemSelectionPadding = 4;
    NSStatusItemSpacing = 4;
    NSWindowResizeTime = 0.2;
    NSWindowShouldDragOnGesture = false;

    ## Inputs
    NSAutomaticCapitalizationEnabled = true;
    NSAutomaticDashSubstitutionEnabled = false;
    NSAutomaticInlinePredictionEnabled = true;
    NSAutomaticPeriodSubstitutionEnabled = true;
    NSAutomaticQuoteSubstitutionEnabled = false;
    NSAutomaticSpellingCorrectionEnabled = true;

    ## Text
    NSTextShowsControlCharacters = true;
    NSUseAnimatedFocusRing = false;

    ## Trackpad nad mouse
    "com.apple.mouse.tapBehavior" = null;
    "com.apple.trackpad.enableSecondaryClick" = false;
    "com.apple.trackpad.forceClick" = false;
    "com.apple.trackpad.scaling" = 0.0;
    "com.apple.trackpad.trackpadCornerClickBehavior" = null;

    ## Sound
    "com.apple.sound.beep.feedback" = 0;
    "com.apple.sound.beep.volume" = 0.2;
    "com.apple.springing.delay" = 0.0;
    "com.apple.springing.enabled" = true;

    ## iCloud
    NSDocumentSaveNewDocumentsToCloud = false;
  };
}
